# ==============================================================================
# Enterprise Autonomous Penetration Testing Platform - Production Environment
# Copy this file to .env.production and fill in secrets before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Server & Runtime Configuration
# ------------------------------------------------------------------------------
PLATFORM_ENV=production
NODE_ENV=production
PLATFORM_PORT=8000
PLATFORM_HOST=0.0.0.0

# Enforce secure cookies (HttpOnly, Secure flag over HTTPS, SameSite=Lax)
PLATFORM_COOKIE_SECURE=true

# Gate development-only demo accounts (true = skips seeding admin, charlie, etc.)
PLATFORM_SEED_DEMO_USERS=false

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets & Key Management
# Generate high-entropy 256-bit / 512-bit random hex strings:
#   openssl rand -hex 32
# ------------------------------------------------------------------------------
# Key used for HMAC-SHA256 signature chain across all audit log events
PLATFORM_AUDIT_KEY=change-me-generate-with-openssl-rand-hex-32-min-length-64-chars

# Secret key used for signing JWT authentication tokens
PLATFORM_JWT_SECRET=change-me-generate-with-openssl-rand-hex-64-min-length-128-chars

# ------------------------------------------------------------------------------
# 3. Bifrost Private LLM Gateway Isolation
# Bifrost is an internal, loopback-only proxy. Never expose port 8080 publicly.
# ------------------------------------------------------------------------------
# BIFROST_TEST_MODE must be strictly set to 'false' in production environments
BIFROST_TEST_MODE=false

# Random one-time setup token for initial internal Bifrost bootstrap
BIFROST_SETUP_TOKEN=change-me-generate-secure-random-token-here

# Internal address accessible only to platform backend within docker network
BIFROST_LLM_BASE=http://bifrost-internal-llm:8080/v1
BIFROST_MCP_URL=http://controlled-security-mcp:3011

# ------------------------------------------------------------------------------
# 4. Google Gemini LLM API Configuration
# ------------------------------------------------------------------------------
# Google AI Studio / Vertex AI Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Consistent model designation across execution metadata, findings, and reports
BIFROST_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Practice Lab & Target Scope Enforcement
# ------------------------------------------------------------------------------
PRACTICE_LAB_URL=http://practice-lab-target:3000
SCOPE_STRICT_MODE=true
MAX_CONCURRENT_SPECIALISTS=4
AUTONOMOUS_MAX_TURNS=20

