# ==============================================================================
# Independent Standalone Platform Server - Production Dockerfile
# ==============================================================================

# --- Stage 1: Build the Go Binary ---
FROM golang:alpine AS builder

WORKDIR /build

RUN apk add --no-cache git gcc musl-dev

# Copy source code and Go workspace
COPY . .

# Build standalone platform server
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /platform-server ./core/cmd/platformserver

# --- Stage 2: Final Minimal Runtime with Python Runner Support ---
FROM python:3.11-slim

WORKDIR /app

# Install security and execution dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy Python requirements if present and install
COPY requirements.txt* /app/
RUN if [ -f /app/requirements.txt ]; then pip install --no-cache-dir -r /app/requirements.txt; fi
RUN pip install --no-cache-dir requests openai httpx openai-agents

# Copy assessment core, runner, capabilities, skills and orchestration
COPY core/assessment /app/core/assessment

# Copy compiled platform server binary
COPY --from=builder /platform-server /usr/local/bin/platform-server

ENV PLATFORM_ENV=production
ENV PLATFORM_PORT=8000
ENV PLATFORM_HOST=0.0.0.0
ENV PLATFORM_APP_DIR=/app
ENV PYTHONPATH=/app

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/platform-server", "-host", "0.0.0.0", "-port", "8000"]

