# ==============================================================================
# VIGIL Platform - Official Production .gitignore
# Excludes secrets, credentials, build artifacts, volumes, logs & local databases
# ==============================================================================

# --- Secrets, Credentials & Environment Files ---
.env
.env.*
!.env.example
!.env.production.example
*.local
*.key
*.pem
*.crt
*.csr
*.pfx
*.p12
.setup_token
*.mcp*.json

# TLS Certificates & Private Keys
deploy/certs/
certs/
*.crt
*.pem

# --- Local Databases & Volumes ---
*.db
*.sqlite
*.sqlite3
config_dump.db
*.rdb
platform-data/
bifrost-data/
audit-logs/
assessment-runs/
data/

# --- Large Documentation Media, Datasets & Video Blobs ---
**/docs/media/
docs/media/
*.mp4
*.mov
*.avi
*.gif
*.pdf
provider-harness.json
openapi.json
dummy-gcp-credentials.json

# --- Temporary & Archive Dumps ---
archive/
tmp/
temp/
scratch/
.cache/

# --- Dependency Directories ---
node_modules/
*/node_modules/
*/*/node_modules/
*/*/*/node_modules/
vendor/

# --- Build Outputs & Compiled Binaries ---
web/dist/
dist/
build/
out/
bin/
*.exe
*.dll
*.so
*.dylib
platform-server-linux
platform-server
mock-security-server*
*-linux

# --- Python Artifacts ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.pytest_cache/

# --- Logs & Personal Browser Data ---
*.log
logs/
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
browser_user_data/
*/browser_user_data/

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
