# ==============================================================================
# VIGIL Platform - Local & Production Environment Template
# Copy this file to .env.production (or .env) and set your secure values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Server & Runtime Configuration
# ------------------------------------------------------------------------------
PLATFORM_ENV=production
NODE_ENV=production
PLATFORM_PORT=8000
PLATFORM_HOST=0.0.0.0

# Enforce secure cookies (HttpOnly, Secure flag over HTTPS, SameSite=Lax)
PLATFORM_COOKIE_SECURE=true

# Gate default demo accounts (admin / krish)
# Set to 'true' to seed default evaluation operators:
#   - admin / AdminPassword2026!
#   - krish / AdminPassword2026!
PLATFORM_SEED_DEMO_USERS=true
PLATFORM_INITIAL_ADMIN_PASSWORD=AdminPassword2026!

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets & Key Management
# Generate high-entropy 256-bit random hex strings with:
#   openssl rand -hex 32
# ------------------------------------------------------------------------------
# Key used for HMAC-SHA256 signature chain across all audit log events
PLATFORM_AUDIT_KEY=your_platform_audit_hmac_key_hex_32

# Secret key used for signing JWT authentication tokens
PLATFORM_JWT_SECRET=your_platform_jwt_signing_secret_hex_32

# ------------------------------------------------------------------------------
# 3. Bifrost Private LLM Gateway
# Bifrost runs internally on private Docker network (never expose port 8080)
# ------------------------------------------------------------------------------
BIFROST_TEST_MODE=false
BIFROST_SETUP_TOKEN=your_bifrost_setup_token_hex_32
BIFROST_VIRTUAL_KEY=your_bifrost_virtual_key_hex_32
BIFROST_LLM_BASE=http://bifrost-internal-llm:8080/v1
BIFROST_MCP_URL=http://controlled-security-mcp:3011

# ------------------------------------------------------------------------------
# 4. Google Gemini LLM API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
BIFROST_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Practice Lab & Target Scope Enforcement
# ------------------------------------------------------------------------------
PRACTICE_LAB_URL=http://platform-practice-lab:3000
PRACTICE_LAB_BROWSER_URL=http://127.0.0.1:5000
SCOPE_STRICT_MODE=true
MAX_CONCURRENT_SPECIALISTS=4
AUTONOMOUS_MAX_TURNS=20

